{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyforge.local/schemas/lesson-v1.json",
  "title": "StudyLesson v1",
  "type": "object",
  "required": ["id", "schemaVersion", "domain", "sourceTopic", "difficulty", "title", "source", "verificationStatus", "objectives", "summary", "concepts", "examples", "questions", "pitfalls", "recap", "sources"],
  "properties": {
    "id": {"type":"string","minLength":1}, "schemaVersion":{"const":1}, "domain":{"type":"string","minLength":1}, "sourceTopic":{"type":"string","minLength":1}, "difficulty":{"enum":["basic","intermediate","advanced","mixed"]}, "title":{"type":"string","minLength":1}, "source":{"$ref":"#/$defs/fileSource"}, "verificationStatus":{"enum":["unverified","verified","needs-review","conflicting"]},
    "objectives":{"type":"array","items":{"$ref":"#/$defs/content"}}, "summary":{"$ref":"#/$defs/content"}, "concepts":{"type":"array","items":{"$ref":"#/$defs/concept"}}, "examples":{"type":"array","items":{"$ref":"#/$defs/content"}}, "questions":{"type":"array","items":{"$ref":"#/$defs/question"}}, "pitfalls":{"type":"array","items":{"$ref":"#/$defs/content"}}, "recap":{"type":"array","items":{"$ref":"#/$defs/content"}}, "sources":{"type":"array","items":{"$ref":"#/$defs/fileSource"}},
    "externalSources":{"type":"array","items":{"$ref":"#/$defs/externalSource"}}, "audit":{"$ref":"#/$defs/auditMeta"}
  },
  "$defs": {
    "span":{"type":"object","required":["start","end","startLine","endLine"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"startLine":{"type":"integer","minimum":1},"endLine":{"type":"integer","minimum":1}},"additionalProperties":false},
    "fileSource":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},
    "externalSource":{"type":"object","required":["type","url","title","checkedAt","locator","sourceHash","logicalSnapshotHash","logicalSnapshotHashMatches","claimIds","verifiedClaimIds","claimStatuses"],"properties":{"type":{"enum":["official-doc","spec","original-paper","vendor","canonical-book","secondary"]},"url":{"type":"string","pattern":"^https://[^\\s]+$"},"title":{"type":"string","minLength":1},"checkedAt":{"type":"string","format":"date"},"version":{"type":"string"},"locator":{"type":"string","minLength":1},"sourceHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"logicalSnapshotHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"logicalSnapshotHashMatches":{"const":true},"claimIds":{"type":"array","items":{"type":"string"}},"verifiedClaimIds":{"type":"array","items":{"type":"string"}},"claimStatuses":{"type":"array","items":{"enum":["VERIFIED","NEEDS_SOURCE","NEEDS_REVIEW","OUTDATED","CONFLICTING"]}}},"additionalProperties":false},
    "auditMeta":{"type":"object","required":["bindingStatus"],"properties":{"coverage":{"type":"object"},"counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"bindingStatus":{"enum":["bound","stale","invalid","missing"]},"warning":{"type":"string","minLength":1}},"additionalProperties":false},
    "markdownSource":{"type":"object","required":["path","sha256","span","anchor"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"span":{"$ref":"#/$defs/span"},"anchor":{"type":"string","minLength":1}},"additionalProperties":false},
    "quizSource":{"type":"object","required":["path","sha256","pointer"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"pointer":{"type":"string","pattern":"^/\\d{2}/\\d+$"}},"additionalProperties":false},
    "evidence":{"oneOf":[{"$ref":"#/$defs/markdownSource"},{"$ref":"#/$defs/quizSource"}]},
    "derivation":{"type":"object","required":["type"],"properties":{"type":{"enum":["extract","authored"]},"rationale":{"type":"string"}},"additionalProperties":false},
    "content":{"type":"object","required":["markdown","plainText","sourceRef","derivation"],"properties":{"markdown":{"type":"string","minLength":1},"plainText":{"type":"string"},"sourceRef":{"$ref":"#/$defs/evidence"},"derivation":{"$ref":"#/$defs/derivation"}},"additionalProperties":false},
    "concept":{"type":"object","required":["id","title","markdown","plainText","sourceRef","derivation"],"properties":{"id":{"type":"string"},"title":{"type":"string","minLength":1},"markdown":{"type":"string","minLength":1},"plainText":{"type":"string"},"sourceRef":{"$ref":"#/$defs/evidence"},"derivation":{"$ref":"#/$defs/derivation"}},"additionalProperties":false},
    "followUp":{"type":"object","required":["question","answer","sourceRef"],"properties":{"question":{"type":"string"},"answer":{"type":["string","null"]},"sourceRef":{"$ref":"#/$defs/markdownSource"}},"additionalProperties":false},
    "question":{"type":"object","required":["id","kind","difficulty","question","answer","explanation","sourceRef","followUps"],"properties":{"id":{"type":"string"},"kind":{"enum":["recall","application","conceptual","comparison","find-error","scenario"]},"difficulty":{"enum":["basic","intermediate","advanced",null]},"question":{"type":"string","minLength":1},"answer":{"type":["string","null"]},"explanation":{"type":"string"},"sourceRef":{"$ref":"#/$defs/evidence"},"derivation":{"$ref":"#/$defs/derivation"},"followUps":{"type":"array","items":{"$ref":"#/$defs/followUp"}}},"additionalProperties":false}
  }, "additionalProperties":false
}
