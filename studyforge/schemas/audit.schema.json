{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyforge.local/schemas/audit.schema.json",
  "title": "StudyForge evidence audit record",
  "type": "object",
  "required": ["schemaVersion", "normalization", "topic", "reviewedAt", "coverage", "sourceHierarchy", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "normalization": { "type": "object", "required": ["lineEndings", "algorithm"], "properties": { "lineEndings": { "const": "LF" }, "algorithm": { "const": "Somente CRLF e CR são convertidos para LF; nenhum outro caractere é transformado." } }, "additionalProperties": false },
    "topic": { "type": "object", "required": ["id", "source"], "properties": { "id": { "type": "string", "minLength": 1 }, "source": { "$ref": "#/$defs/fileSource" } }, "additionalProperties": false },
    "reviewedAt": { "type": "string", "format": "date" },
    "coverage": { "type": "object", "required": ["completeTopicReview", "scope"], "properties": { "completeTopicReview": { "const": false }, "scope": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "sourceHierarchy": { "type": "array", "items": { "enum": ["official-doc", "spec", "original-paper", "vendor", "canonical-book", "secondary"] } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "fileSource": { "type": "object", "required": ["path", "sha256", "rawSha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "externalSource": { "type": "object", "required": ["type", "url", "title", "checkedAt", "locator"], "properties": { "type": { "enum": ["official-doc", "spec", "original-paper", "vendor", "canonical-book", "secondary"] }, "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "title": { "type": "string", "minLength": 1 }, "checkedAt": { "type": "string", "format": "date" }, "version": { "type": "string" }, "locator": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "claim": { "type": "object", "required": ["id", "statement", "text", "assertion", "status", "justification", "source", "externalSources", "proposedChanges"], "properties": {
      "id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "assertion": { "type": "string", "minLength": 1 }, "verifiedScope": { "type": "string" }, "context": { "type": "string" }, "status": { "enum": ["VERIFIED", "NEEDS_SOURCE", "NEEDS_REVIEW", "OUTDATED", "CONFLICTING"] }, "justification": { "type": "string", "minLength": 1 },
      "source": { "type": "object", "required": ["path", "sha256", "rawSha256", "span", "sectionId", "anchor", "contextSpan"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "span": { "$ref": "#/$defs/span" }, "contextSpan": { "$ref": "#/$defs/span" }, "sectionId": { "type": "string", "minLength": 1 }, "anchor": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      "externalSources": { "type": "array", "items": { "$ref": "#/$defs/externalSource" } }, "evidence": { "type": ["object", "null"], "properties": { "excerpt": { "type": "string", "minLength": 1 }, "excerptKind": { "enum": ["quote", "paraphrase", "calculation"] }, "locator": { "type": "string", "minLength": 1 } }, "required": ["excerpt", "excerptKind", "locator"], "additionalProperties": false }, "review": { "type": ["object", "null"], "properties": { "checkedAt": { "type": "string", "format": "date" }, "method": { "type": "string", "minLength": 1 }, "responsibility": { "type": "string", "minLength": 1 } }, "required": ["checkedAt", "method", "responsibility"], "additionalProperties": false },
      "proposedChanges": { "type": "array", "items": { "type": "object", "required": ["original", "proposed", "reason", "sources"], "properties": { "original": { "type": "string", "minLength": 1 }, "proposed": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } } }, "additionalProperties": false } }
    }, "additionalProperties": false },
    "span": { "type": "object", "required": ["start", "end", "startLine", "endLine"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
