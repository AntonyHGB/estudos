{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyforge.local/schemas/quiz-bank-v1.json",
  "title": "Estudos quiz source bank",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {"pattern": "^\\d{2}$"},
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["n", "q", "a", "c", "e"],
      "properties": {
        "n": {"enum": ["🟢", "🟡", "🔴"]},
        "q": {"type": "string", "minLength": 1},
        "a": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "c": {"type": "integer", "minimum": 0},
        "e": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
